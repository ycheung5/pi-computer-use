{
  "name": "pi-computer-use",
  "version": "0.1.0",
  "description": "Native Pi tools for Windows computer use from Windows and WSL2",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "computer-use",
    "windows"
  ],
  "files": [
    "dist",
    "README.md",
    "GLOSSARY.md",
    "docs/",
    "assets/"
  ],
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome check .",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepack": "npm run build",
    "lint:fix": "biome check --write .",
    "test:native": "node tests/native-health.mjs",
    "test:native:windows": "node tests/native-windows.mjs",
    "test:wsl": "node tests/wsl-health.mjs",
    "test:native:accessibility": "node tests/native-accessibility.mjs",
    "test:native:nullable-uia": "node tests/native-nullable-uia.mjs",
    "test:native:chromium": "node tests/native-chromium-accessibility.mjs",
    "test:ownership": "node tests/ownership-host.mjs",
    "test:native:capture": "node tests/native-capture.mjs",
    "test:native:ocr": "node tests/native-ocr.mjs",
    "test:stop": "node tests/stop-host.mjs",
    "test:browser": "node tests/browser-host.mjs",
    "test:native:controls": "node tests/native-controls.mjs",
    "test:native:waits": "node tests/native-waits.mjs",
    "test:settings": "node tests/settings-host.mjs",
    "test:native:management": "node tests/native-window-management.mjs",
    "test:native:pointer:guards": "node tests/native-pointer-guards.mjs",
    "test:native:pointer:physical": "node tests/native-pointer-physical.mjs",
    "test:native:text": "node tests/native-text.mjs",
    "test:native:text:physical": "node tests/native-text-physical.mjs",
    "test:browser:actions": "node tests/browser-actions-host.mjs",
    "test:browser:firefox:endpoint": "node tests/browser-firefox-endpoint.mjs",
    "test:indicators": "node tests/indicators-host.mjs",
    "test:browser:profiles": "node tests/browser-profiles-host.mjs",
    "test:package": "node tests/package-host.mjs",
    "test:pi": "node tests/pi-host.mjs",
    "benchmark:reference": "node tests/benchmark-reference.mjs",
    "test:parity": "node tests/parity-host.mjs",
    "test:browser:foreground": "node tests/browser-foreground-host.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "22.19.19",
    "tsx": "4.21.0",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  },
  "overrides": {
    "undici": "8.12.2",
    "esbuild": "0.28.1"
  },
  "dependencies": {
    "puppeteer-core": "25.16.0"
  }
}
